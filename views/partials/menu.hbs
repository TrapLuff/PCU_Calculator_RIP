<div class="components-container">
  {{#each data.components}}
    {{#if this.isActive}}
    <div class="component-item">
        <div class="component-title">
            <a href="/component/{{this.id}}">{{this.title}}</a>
        </div>
        <div class = "component-other">
            <div class="component-img-main">
              <a href="/component/{{this.id}}">
                <img src="http://localhost:9000/psu-calculator/{{this.image}}" alt="{{this.title}} Logo" class="component-logo">
              </a>
            </div>
            <div class="component-info">
                <p class="component-info-text">Макс. тепловыделение: {{this.tdp_up}} Вт.</p>
                <p class="component-info-text">Базовое тепловыделение: {{this.tdp_typical}} Вт.</p>
                <div class="component-info-status">
                  <p class="component-status">Выбрано: {{this.quantity}}</p>
                  <form action="/build/add-component/{{this.id}}" method="POST">
                    <input type="hidden" name="returnUrl" value="{{../currentUrl}}">
                    <button type="submit">Добавить</button>
                  </form>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
  {{else}}
    <div class="component-item">
      Список пуст
    </div>
  {{/each}}
</div>
